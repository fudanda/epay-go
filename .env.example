# epay-go/.env.example
# 数据库配置
DB_USER=postgres.lzserver
DB_PASSWORD=<POSTGRES_PASSWORD>
DB_NAME=postgres
DB_PORT=55432

# Go 模块代理
GOPROXY=https://goproxy.cn,direct

# JWT 密钥
JWT_SECRET=<JWT_SECRET>

# 默认管理员初始化（仅数据库中不存在管理员时生效）
DEFAULT_ADMIN_USERNAME=epay_admin
DEFAULT_ADMIN_PASSWORD=<DEFAULT_ADMIN_PASSWORD>

# 支付宝配置
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 微信支付配置
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=

#域名配置
SITE_ADDRESS=pay.example.com
ACME_EMAIL=admin@example.com
REDIS_PASSWORD=<REDIS_PASSWORD>
